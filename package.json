{
  "name": "@preptex/ui",
  "version": "0.1.1",
  "description": "Reusable React UI workspace, components, layout/file hooks, and design tokens for PrepTeX applications.",
  "keywords": [
    "preptex",
    "latex",
    "tex",
    "react",
    "ast",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/preptex/preptex-ui.git"
  },
  "bugs": {
    "url": "https://github.com/preptex/preptex-ui/issues"
  },
  "homepage": "https://github.com/preptex/preptex-ui#readme",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/styles/tokens.css",
    "./styles.css": "./dist/styles/bundle.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "node scripts/build.mjs",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "type-test": "npm run build && tsc -p tsconfig.type-tests.json",
    "lint": "eslint src type-tests --ext .ts,.tsx --max-warnings=0",
    "test": "jest",
    "test:ci": "jest --watchAll=false --runInBand",
    "pack:check": "npm pack --dry-run",
    "verify:package": "node scripts/verify-package.mjs",
    "consumer:check": "node scripts/verify-package.mjs --consumer",
    "check": "npm run typecheck && npm run lint && npm run test:ci && npm run type-test && npm run verify:package"
  },
  "peerDependencies": {
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@preptex/core": "^0.6.2",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.4",
    "@preptex/core": "^0.6.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "babel-jest": "^27.5.1",
    "codemirror": "^6.0.2",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "jest": "^27.5.1",
    "jest-environment-jsdom": "^27.5.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^4.9.5"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "@typescript-eslint/no-explicit-any": "error"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
